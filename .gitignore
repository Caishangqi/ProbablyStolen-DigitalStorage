# Allowlist: ignore every top-level entry, then admit only the project files below.
# A new top-level file or directory must be added here explicitly before it can be committed.
/*
!/.editorconfig
!/.gitattributes
!/.gitignore
!/.github/
!/.idea/
!/.run/
!/DigitalStorage.Core.slnf
!/DigitalStorage.sln
!/Directory.Build.props
!/Directory.Build.targets
!/Directory.Packages.props
!/global.json
!/mise.local.toml.example
!/mise.toml
!/packaging/
!/pyproject.toml
!/scripts/
!/src/
!/tests/
!/uv.lock

# Local secrets and per-machine settings inside admitted directories.
.env
.env.*
!.env.example
*.local.json
.secrets/

# Build and test output.
**/bin/
**/obj/
**/.vs/
**/TestResults/
**/node_modules/
**/dist/
**/coverage/
**/.venv/
**/.vite/
**/__pycache__/
**/.pytest_cache/
*.py[cod]

# Rider: keep only the shared solution settings.
/.idea/*
!/.idea/.idea.*/
/.idea/.idea.*/.idea/*
!/.idea/.idea.*/.idea/vcs.xml
!/.idea/.idea.*/.idea/.gitignore

# Editor and operating-system files.
.DS_Store
Thumbs.db
*.user
*.suo
*.swp
*.tmp
*.log
