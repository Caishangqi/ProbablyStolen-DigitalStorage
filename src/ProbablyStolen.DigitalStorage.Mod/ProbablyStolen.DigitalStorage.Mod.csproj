<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>ProbablyStolen.DigitalStorage.Mod</AssemblyName>
    <RootNamespace>ProbablyStolen.DigitalStorage.Mod</RootNamespace>
    <RequireProbablyStolenReferences>true</RequireProbablyStolenReferences>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- The game's loader only runs PatchAll on the assembly that implements IMod, so Harmony patches live here. -->
  <ItemGroup Condition="'$(DigitalStorageManagedDirectory)' != ''">
    <Reference Include="0Harmony">
      <HintPath>$(DigitalStorageManagedDirectory)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ProbablyStolen.DigitalStorage.Common\ProbablyStolen.DigitalStorage.Common.csproj" />
    <ProjectReference Include="..\ProbablyStolen.DigitalStorage.Client\ProbablyStolen.DigitalStorage.Client.csproj" />
    <ProjectReference Include="..\ProbablyStolen.DigitalStorage.Platform\ProbablyStolen.DigitalStorage.Platform.csproj" />
  </ItemGroup>
</Project>
