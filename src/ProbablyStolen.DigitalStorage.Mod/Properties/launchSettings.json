{
  "$schema": "https://json.schemastore.org/launchsettings.json",
  "profiles": {
    "Game: Build Deploy Launch": {
      "commandName": "Executable",
      "executablePath": "powershell.exe",
      "commandLineArgs": "-NoProfile -ExecutionPolicy Bypass -File scripts/start-game.ps1 -BuildAndDeploy",
      "workingDirectory": "$(MSBuildProjectDirectory)/../..",
      "environmentVariables": {
        "DIGITAL_STORAGE_GAME_DIR": "$(DigitalStorageGameDirectory)"
      }
    },
    "Game: Launch": {
      "commandName": "Executable",
      "executablePath": "powershell.exe",
      "commandLineArgs": "-NoProfile -ExecutionPolicy Bypass -File scripts/start-game.ps1",
      "workingDirectory": "$(MSBuildProjectDirectory)/../..",
      "environmentVariables": {
        "DIGITAL_STORAGE_GAME_DIR": "$(DigitalStorageGameDirectory)"
      }
    },
    "Game: Plan": {
      "commandName": "Executable",
      "executablePath": "powershell.exe",
      "commandLineArgs": "-NoProfile -ExecutionPolicy Bypass -File scripts/start-game.ps1 -BuildAndDeploy -Plan",
      "workingDirectory": "$(MSBuildProjectDirectory)/../..",
      "environmentVariables": {
        "DIGITAL_STORAGE_GAME_DIR": "$(DigitalStorageGameDirectory)"
      }
    },
    "Common: Build": {
      "commandName": "Executable",
      "executablePath": "dotnet",
      "commandLineArgs": "build src/ProbablyStolen.DigitalStorage.Common/ProbablyStolen.DigitalStorage.Common.csproj --configuration Debug",
      "workingDirectory": "$(MSBuildProjectDirectory)/../..",
      "environmentVariables": {
        "DIGITAL_STORAGE_GAME_DIR": "$(DigitalStorageGameDirectory)"
      }
    },
    "Common: Test": {
      "commandName": "Executable",
      "executablePath": "powershell.exe",
      "commandLineArgs": "-NoProfile -ExecutionPolicy Bypass -File scripts/test.ps1 -Target Common",
      "workingDirectory": "$(MSBuildProjectDirectory)/../..",
      "environmentVariables": {
        "DIGITAL_STORAGE_GAME_DIR": "$(DigitalStorageGameDirectory)"
      }
    },
    "Client: Build": {
      "commandName": "Executable",
      "executablePath": "dotnet",
      "commandLineArgs": "build src/ProbablyStolen.DigitalStorage.Client/ProbablyStolen.DigitalStorage.Client.csproj --configuration Debug",
      "workingDirectory": "$(MSBuildProjectDirectory)/../..",
      "environmentVariables": {
        "DIGITAL_STORAGE_GAME_DIR": "$(DigitalStorageGameDirectory)"
      }
    },
    "Client: Test": {
      "commandName": "Executable",
      "executablePath": "powershell.exe",
      "commandLineArgs": "-NoProfile -ExecutionPolicy Bypass -File scripts/test.ps1 -Target Client",
      "workingDirectory": "$(MSBuildProjectDirectory)/../..",
      "environmentVariables": {
        "DIGITAL_STORAGE_GAME_DIR": "$(DigitalStorageGameDirectory)"
      }
    },
    "Platform: Build": {
      "commandName": "Executable",
      "executablePath": "dotnet",
      "commandLineArgs": "build src/ProbablyStolen.DigitalStorage.Platform.ProbablyStolen/ProbablyStolen.DigitalStorage.Platform.ProbablyStolen.csproj --configuration Debug",
      "workingDirectory": "$(MSBuildProjectDirectory)/../..",
      "environmentVariables": {
        "DIGITAL_STORAGE_GAME_DIR": "$(DigitalStorageGameDirectory)"
      }
    },
    "Mod: Build": {
      "commandName": "Executable",
      "executablePath": "dotnet",
      "commandLineArgs": "build src/ProbablyStolen.DigitalStorage.Mod/ProbablyStolen.DigitalStorage.Mod.csproj --configuration Debug",
      "workingDirectory": "$(MSBuildProjectDirectory)/../..",
      "environmentVariables": {
        "DIGITAL_STORAGE_GAME_DIR": "$(DigitalStorageGameDirectory)"
      }
    },
    "Integration: Test": {
      "commandName": "Executable",
      "executablePath": "powershell.exe",
      "commandLineArgs": "-NoProfile -ExecutionPolicy Bypass -File scripts/test.ps1 -Target Integration",
      "workingDirectory": "$(MSBuildProjectDirectory)/../..",
      "environmentVariables": {
        "DIGITAL_STORAGE_GAME_DIR": "$(DigitalStorageGameDirectory)"
      }
    },
    "Architecture: Check": {
      "commandName": "Executable",
      "executablePath": "powershell.exe",
      "commandLineArgs": "-NoProfile -ExecutionPolicy Bypass -File scripts/validate-repository.ps1 -Target Architecture",
      "workingDirectory": "$(MSBuildProjectDirectory)/../..",
      "environmentVariables": {
        "DIGITAL_STORAGE_GAME_DIR": "$(DigitalStorageGameDirectory)"
      }
    },
    "Tests: All": {
      "commandName": "Executable",
      "executablePath": "powershell.exe",
      "commandLineArgs": "-NoProfile -ExecutionPolicy Bypass -File scripts/test.ps1 -Target All",
      "workingDirectory": "$(MSBuildProjectDirectory)/../..",
      "environmentVariables": {
        "DIGITAL_STORAGE_GAME_DIR": "$(DigitalStorageGameDirectory)"
      }
    },
    "Repository: Check": {
      "commandName": "Executable",
      "executablePath": "powershell.exe",
      "commandLineArgs": "-NoProfile -ExecutionPolicy Bypass -File scripts/validate-repository.ps1 -Target Static",
      "workingDirectory": "$(MSBuildProjectDirectory)/../..",
      "environmentVariables": {
        "DIGITAL_STORAGE_GAME_DIR": "$(DigitalStorageGameDirectory)"
      }
    },
    "Package: Build": {
      "commandName": "Executable",
      "executablePath": "powershell.exe",
      "commandLineArgs": "-NoProfile -ExecutionPolicy Bypass -File scripts/package.ps1",
      "workingDirectory": "$(MSBuildProjectDirectory)/../..",
      "environmentVariables": {
        "DIGITAL_STORAGE_GAME_DIR": "$(DigitalStorageGameDirectory)"
      }
    },
    "Deploy: Install": {
      "commandName": "Executable",
      "executablePath": "powershell.exe",
      "commandLineArgs": "-NoProfile -ExecutionPolicy Bypass -File scripts/deploy.ps1 -Action Deploy",
      "workingDirectory": "$(MSBuildProjectDirectory)/../..",
      "environmentVariables": {
        "DIGITAL_STORAGE_GAME_DIR": "$(DigitalStorageGameDirectory)"
      }
    }
  }
}
