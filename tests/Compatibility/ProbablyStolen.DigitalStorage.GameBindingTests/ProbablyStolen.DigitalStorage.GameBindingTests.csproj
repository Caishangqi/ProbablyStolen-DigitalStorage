<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit3TestAdapter" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\ProbablyStolen.DigitalStorage.Mod\ProbablyStolen.DigitalStorage.Mod.csproj" />
  </ItemGroup>

  <!--
    The lookups load game types from the build under test, so the game's own assemblies are copied next to the tests.
    The base class library facades in Managed belong to Unity's runtime and are left to the test host.
  -->
  <ItemGroup Condition="'$(DigitalStorageManagedDirectory)' != ''">
    <GameAssembly Include="$(DigitalStorageManagedDirectory)\*.dll"
                  Exclude="$(DigitalStorageManagedDirectory)\mscorlib.dll;$(DigitalStorageManagedDirectory)\netstandard.dll;$(DigitalStorageManagedDirectory)\System*.dll;$(DigitalStorageManagedDirectory)\Microsoft*.dll;$(DigitalStorageManagedDirectory)\Mono*.dll" />
    <Reference Include="@(GameAssembly)" Private="true" />
  </ItemGroup>
</Project>
